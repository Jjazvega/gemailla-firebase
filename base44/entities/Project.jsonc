{
  "name": "Project",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planificado",
        "en_curso",
        "pausado",
        "completado",
        "cancelado"
      ],
      "default": "planificado"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baja",
        "media",
        "alta",
        "critica"
      ],
      "default": "media"
    },
    "owner": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "budget": {
      "type": "number"
    },
    "spent": {
      "type": "number",
      "default": 0
    },
    "progress": {
      "type": "number",
      "default": 0
    },
    "team": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "company_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.company_id": {
        "$in": {
          "_collection": "CompanyMember",
          "_query": {
            "data.user_email": "{{user.email}}",
            "data.status": "active"
          },
          "_field": "data.company_id"
        }
      }
    },
    "read": {
      "data.company_id": {
        "$in": {
          "_collection": "CompanyMember",
          "_query": {
            "data.user_email": "{{user.email}}",
            "data.status": "active"
          },
          "_field": "data.company_id"
        }
      }
    },
    "update": {
      "data.company_id": {
        "$in": {
          "_collection": "CompanyMember",
          "_query": {
            "data.user_email": "{{user.email}}",
            "data.status": "active"
          },
          "_field": "data.company_id"
        }
      }
    },
    "delete": {
      "data.company_id": {
        "$in": {
          "_collection": "CompanyMember",
          "_query": {
            "data.user_email": "{{user.email}}",
            "data.status": "active"
          },
          "_field": "data.company_id"
        }
      }
    }
  }
}
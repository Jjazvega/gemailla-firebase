{
  "name": "CRMClient",
  "type": "object",
  "properties": {
    "company_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "rfc": {
      "type": "string"
    },
    "segment": {
      "type": "string",
      "enum": [
        "premium",
        "recurrente",
        "potencial",
        "inactivo",
        "perdido"
      ],
      "default": "potencial"
    },
    "industry": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "activo",
        "inactivo"
      ],
      "default": "activo"
    }
  },
  "required": [
    "company_id",
    "name"
  ],
  "rls": {
    "create": {
      "data.company_id": {
        "$in": {
          "_collection": "CompanyMember",
          "_query": {
            "data.user_email": "{{user.email}}",
            "data.role": "director",
            "data.status": "active"
          },
          "_field": "data.company_id"
        }
      }
    },
    "read": {
      "data.company_id": {
        "$in": {
          "_collection": "CompanyMember",
          "_query": {
            "data.user_email": "{{user.email}}",
            "data.status": "active"
          },
          "_field": "data.company_id"
        }
      }
    },
    "update": {
      "data.company_id": {
        "$in": {
          "_collection": "CompanyMember",
          "_query": {
            "data.user_email": "{{user.email}}",
            "data.role": "director",
            "data.status": "active"
          },
          "_field": "data.company_id"
        }
      }
    },
    "delete": {
      "data.company_id": {
        "$in": {
          "_collection": "CompanyMember",
          "_query": {
            "data.user_email": "{{user.email}}",
            "data.role": "director",
            "data.status": "active"
          },
          "_field": "data.company_id"
        }
      }
    }
  }
}